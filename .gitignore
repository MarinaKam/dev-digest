node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
# Every env file holds secrets or machine settings; only the templates are tracked.
.env
.env.*
!.env.example
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# Machine-local Compose overrides (e.g. a different host port for Postgres)
docker-compose.override.yml

# Browser-check artefacts of the Playwright MCP tool (screenshots, snapshots, logs)
.playwright-mcp/

# Verdict and override log of the pr-self-review skill (local state, one per checkout)
.claude/.pr-self-review.json
.claude/.pr-self-review.log

# Output of the demo-video skill (flows, videos, contact sheets). The scenarios
# they are built from are tracked in docs/demos/.
/demo/
